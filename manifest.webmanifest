{
  "name": "Photos Boutique",
  "short_name": "Photos Boutique",
  "description": "Redimensionne et compresse les photos produit avant mise en ligne sur la boutique.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "lang": "fr",
  "background_color": "#F1F3F2",
  "theme_color": "#1F6F5C",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "images", "accept": ["image/jpeg", "image/png", "image/webp", "image/*"] }]
    }
  }
}
